# .env.example — modello di configurazione AI (copia in `.env` e compila)
# --------------------------------------------------------------------------
# Le chiavi qui dentro NON vengono mai committate: `.env` e`.env.*` sono gia'
# esclusi dal versionamento (.gitignore). Questo file serve solo da template.
#
# Basta la chiave di UN provider per partire; il router usa automaticamente
# tutti i modelli gratuiti del provider e fa switch quando la quota giornaliera
# e' esaurita. Piu' chiavi = piu' modelli nella rotazione = meno attese.
# --------------------------------------------------------------------------

# --- Provider consigliati (gratuiti, compatibili OpenAI) ------------------
GROQ_API_KEY=            # https://console.groq.com/keys        (14.4k req/giorno, veloce)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey   (1.5M req/mese, vision)
MISTRAL_API_KEY=         # https://console.mistral.ai/          (free tier experiment)
OPENROUTER_API_KEY=      # https://openrouter.ai/keys           (modelli :free multipli)
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai/           (30 req/min, veloce)
SAMBANOVA_API_KEY=      # https://cloud.sambanova.ai/apitokens (free credits iniziali)
GITHUB_TOKEN=            # https://github.com/settings/tokens   (models free tier)
DEEPSEEK_API_KEY=        # https://platform.deepseek.com/api_keys

# --- Base URL personalizzabili (opzionali; default gia' nel catalogo) ------
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Provider locale (GRATIS illimitato, nessuna chiave) -------------------
# Avvia Ollama sul PC (`ollama serve`) e scarica un modello, es.:
#   ollama pull qwen3:14b
# L'app lo usa come fallback automatico quando le quote cloud finiscono.
OLLAMA_BASE_URL=http://localhost:11434
